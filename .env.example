# Copy to .env and set real values. .env is git-ignored.
# SA password must meet SQL Server complexity rules (8+ chars, upper, lower, digit, symbol).
# Do not use $ ; ' or " in the password: they break Docker Compose and the connection string.
SA_PASSWORD=ChangeMe_Str0ng!Passw0rd
ASPNETCORE_ENVIRONMENT=Development
# Host port for SQL Server. Change it if a local SQL Server already uses 1433.
SQL_HOST_PORT=1433
